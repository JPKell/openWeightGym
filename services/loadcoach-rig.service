[Unit]
Description=LoadCoach second-instance placement rig
After=network-online.target

[Service]
ExecStart=%h/ai/openWeightGym/.venv/bin/loadcoach --config %h/ai/openWeightGym/settings/loadcoach-rig.toml
EnvironmentFile=-%h/ai/openWeightGym/.env
Restart=on-failure
RestartSec=3
MemoryHigh=22G
MemoryMax=24G
MemorySwapMax=0

# This test instance is started manually and is not enabled at login.
